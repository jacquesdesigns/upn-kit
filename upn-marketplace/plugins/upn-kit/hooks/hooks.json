{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/session_start.py\" || py \"${CLAUDE_PLUGIN_ROOT}/hooks/session_start.py\"",
            "timeout": 40
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/context.py\" || py \"${CLAUDE_PLUGIN_ROOT}/hooks/context.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/catch.py\" || py \"${CLAUDE_PLUGIN_ROOT}/hooks/catch.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/brainsearch/lookfirst.py\" || py \"${CLAUDE_PLUGIN_ROOT}/hooks/brainsearch/lookfirst.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash|PowerShell|mcp__.*[Dd]ropbox.*",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/guards.py\" || py \"${CLAUDE_PLUGIN_ROOT}/hooks/guards.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/right_source.py\" || py \"${CLAUDE_PLUGIN_ROOT}/hooks/right_source.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/catch.py\" || py \"${CLAUDE_PLUGIN_ROOT}/hooks/catch.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/routing.py\" || py \"${CLAUDE_PLUGIN_ROOT}/hooks/routing.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/voice.py\" || py \"${CLAUDE_PLUGIN_ROOT}/hooks/voice.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/proof.py\" || py \"${CLAUDE_PLUGIN_ROOT}/hooks/proof.py\"",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/closeout_stop.py\" || py \"${CLAUDE_PLUGIN_ROOT}/hooks/closeout_stop.py\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}